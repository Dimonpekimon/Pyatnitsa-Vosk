# =====================================================================
#  Личные настройки и секреты — НИКОГДА не публикуются.
#  Токен Telegram-бота, абсолютные пути пользователя.
#  Шаблон для новых установок: pyatnitsa_settings.example.json
# =====================================================================
pyatnitsa_settings.json
pyatnitsa_settings.json.bak
*.json.bak

# =====================================================================
#  Рабочие данные ассистента: модели, кэш озвучки, заметки, напоминания,
#  лог. Здесь же лежат скачанные модели Whisper (сотни мегабайт).
# =====================================================================
data/

# Голоса Piper и прочие крупные модели — качаются скриптом download_voices.py
*.onnx
*.onnx.json

# =====================================================================
#  Сборка и служебные файлы
# =====================================================================
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
outputs/

# node_modules тянется npm install; здесь он ещё и символическая ссылка
node_modules/

# Собранное окно (desktop/dist) НЕ игнорируется специально: без него
# «клон → запуск» требует Node.js. Весит оно меньше полумегабайта.

# Собранный лаунчер «Пятница.exe» коммитится намеренно: клон → двойной щелчок
# → ассистент запущен, без PyInstaller и без консоли. Пересобирается
# build_exe.py. Старое имя не тянем.
Джарвис.exe

# Логи
*.log

# Rust-мозг: сборочный каталог Cargo (1,3 ГБ артефактов). Бинарь собирается
# командой `cd brain-rs && cargo build --release`.
brain-rs/target/

# Память и навыки рабочего окружения — не часть продукта
.workbuddy-ai/

# Виртуальные окружения
.venv/
venv/
env/

# Мусор Windows и редакторов
Thumbs.db
desktop.ini
.DS_Store
*.swp
